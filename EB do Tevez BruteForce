-- FICHEIROS
local function fread(f)    return (isfile and isfile(f) and readfile(f)) or "" end
local function fwrite(f,d) if writefile then writefile(f,d) end end
local function saveProgress(c) fwrite("xb_prog.txt",   tostring(c)) end
local function loadProgress()  return tonumber(fread("xb_prog.txt")) end
local function saveTarget(x,y) fwrite("xb_target.txt", x..","..y) end
local function loadTarget()    local x,y=fread("xb_target.txt"):match("(%d+),(%d+)"); return tonumber(x),tonumber(y) end
local function saveCode(c)     fwrite("xb_codes.txt",  fread("xb_codes.txt")..c.."\n") end
local function getCodes()      local t={}; for l in fread("xb_codes.txt"):gmatch("[^\n]+") do t[#t+1]=l end; return t end

