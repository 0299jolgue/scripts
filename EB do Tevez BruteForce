-- UI HELPERS
local G = Color3.fromRGB
local function corner(p,r) local c=Instance.new("UICorner",p); c.CornerRadius=UDim.new(0,r or 6) end
local function stroke(p,c,t) local s=Instance.new("UIStroke",p); s.Color=c or G(0,255,140); s.Thickness=t or 1.5 end
local function frame(p,x,y,w,h,bg)
    local f=Instance.new("Frame",p)
    f.Position=UDim2.new(0,x,0,y); f.Size=UDim2.new(0,w,0,h)
    f.BackgroundColor3=bg or G(12,12,18); f.BorderSizePixel=0; f.ZIndex=4
    return f
end
local function label(p,txt,x,y,w,h,col,ts)
    local l=Instance.new("TextLabel",p)
    l.Text=txt; l.Position=UDim2.new(0,x,0,y); l.Size=UDim2.new(0,w,0,h)
    l.BackgroundTransparency=1; l.TextColor3=col or G(200,200,200)
    l.Font=Enum.Font.Code; l.TextSize=ts or 10
    l.TextXAlignment=Enum.TextXAlignment.Left; l.ZIndex=5
    return l
end
local function btn(p,txt,x,y,w,h,bg,tc)
    local b=Instance.new("TextButton",p)
    b.Text=txt; b.Position=UDim2.new(0,x,0,y); b.Size=UDim2.new(0,w,0,h)
    b.BackgroundColor3=bg; b.TextColor3=tc
    b.Font=Enum.Font.Code; b.TextSize=10; b.BorderSizePixel=0; b.ZIndex=5
    corner(b,4); return b
end

