-- SAFEWAIT
local function sw(s)
    if s<=0 then return end
    local n=math.max(1,math.ceil(s/0.05))
    for _=1,n do if not running then return end; task.wait(s/n) end
end

-- CLICK — SEM mousemoveabs para nao minimizar
local function doClick(x,y)
    pcall(function()
        VIM:SendMouseButtonEvent(x,y,0,true,game,false)
        task.wait(0.02)
        VIM:SendMouseButtonEvent(x,y,0,false,game,false)
    end)
end

local function clickTarget(b)
    if clickX and clickY then
        doClick(clickX,clickY); return
    end
    if not b then return end
    -- tenta disparar o evento directamente
    if getconnections then
        for _,ev in ipairs({b.MouseButton1Click,b.Activated}) do
            local ok,cs=pcall(getconnections,ev)
            if ok and cs then for _,c in ipairs(cs) do pcall(function()c:Fire()end) end end
        end
    end
    local p=b.AbsolutePosition; local s=b.AbsoluteSize
    doClick(math.floor(p.X+s.X*.5),math.floor(p.Y+s.Y*.5))
end

-- GET UI
local function getUI()
    local rs=pg:FindFirstChild("ReserverServer"); if not rs then return nil,nil end
    local fr=rs:FindFirstChild("Frame"); if not fr then return nil,nil end
    local jn=fr:FindFirstChild("Join"); if not jn then return nil,nil end
    return jn:FindFirstChild("TextBox"),jn:FindFirstChild("JoinButton")
end
local function guiAlive() local t,b=getUI(); return t~=nil and b~=nil end
local function findByText()
    for _,o in ipairs(pg:GetDescendants()) do
        if o:IsA("TextButton") and o.Visible and o.AbsoluteSize.X>0 then
            local t=o.Text:lower()
            if t:find("entrar") or t:find("join") then return o end
        end
    end
end

-- BRUTE FORCE
local function brute()
    running=true; StartBtn.Text="[ PARAR ]"; StartBtn.BackgroundColor3=G(110,25,25)
    if not clickX or not clickY then Log("[!] Sem alvo — usando fallback.",G(255,180,60)) end
    local s=math.clamp(math.floor(tonumber(SNBox.Text) or 100000),100000,999999)
    SNBox.Text=tostring(s)
    Log(("[>>] %d -> 999999"):format(s),G(255,255,255))
    for code=s,999999 do
        if not running then Log("[!!] Parado.",G(255,180,60)); break end
        local t0=os.clock()
        lastTried=code; saveProgress(code)

        Disp.Text=("%06d"):format(code)
        Stat.Text=("Codigo: %d | CPS: %d"):format(code,CPS)

        local txt,b=getUI()
        if not b then b=findByText() end
        if not txt then Log("[!!] TextBox nao encontrada.",G(255,80,80)); running=false; break end
        txt.Text=tostring(code)
        sw(0.02); if not running then break end
        clickTarget(b)
        sw(0.06); if not running then break end

        if not guiAlive() then
            Disp.Text="OK "..code; Stat.Text="Codigo certo: "..code
            Log("[OK] CODIGO -> "..code,G(0,255,140))
            saveCode(tostring(code)); SNBox.Text=tostring(code+1)
            running=false; break
        end
        local gap=(1/CPS)-(os.clock()-t0)
        if gap>0 then sw(gap) end
    end
    if running then Log("[--] Concluido.",G(255,130,80)); running=false end
    StartBtn.Text="INICIAR"; StartBtn.BackgroundColor3=G(0,90,58)
end

StartBtn.MouseButton1Click:Connect(function()
    if running then
        running=false; saveProgress(lastTried)
        Log("[!!] Parado. Guardado: "..lastTried,G(255,200,60))
    else task.spawn(brute) end
end)

